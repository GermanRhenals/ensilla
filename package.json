{
  "name": "ensilla",
  "version": "1.0.0",
  "private": true,
  "description": "En-silla: reservas online y panel de gestion para barberia. Next.js estatico + Supabase.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx --yes serve out",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "smoke:supabase": "node --env-file=.env scripts/smoke-supabase.mjs",
    "db:seed:supabase": "node --env-file=.env scripts/seed-supabase.mjs",
    "db:create-shop": "node --env-file=.env scripts/create-shop.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "lucide-react": "^1.62.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
