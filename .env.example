NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_DB_PASSWORD="your-db-password"

# GitHub Pages project site: /<repo-name>. Leave empty for local dev.
NEXT_PUBLIC_BASE_PATH=""

# Fallbacks used before the shop settings load (shop panel can override them).
NEXT_PUBLIC_DEFAULT_TIMEZONE="America/Bogota"
NEXT_PUBLIC_DEFAULT_CURRENCY="COP"
NEXT_PUBLIC_DEFAULT_LOCALE="es-CO"
NEXT_PUBLIC_DEFAULT_WHATSAPP_COUNTRY_CODE="57"

# Demo seed only: set these to create the initial shop in another country.
SHOP_TIMEZONE="America/Bogota"
SHOP_CURRENCY="COP"
SHOP_LOCALE="es-CO"
SHOP_WHATSAPP_COUNTRY_CODE="57"
