# ---------------------------------------------------------------------------
# En-silla · variables de entorno
# ---------------------------------------------------------------------------
# Copiá este archivo como `.env` y completá los valores reales.
# `.env` NO se versiona: contiene la clave de servicio, que da acceso total.
# En GitHub Pages, las variables `NEXT_PUBLIC_*` se configuran como Secrets del
# repositorio y se inyectan en tiempo de build.
# ---------------------------------------------------------------------------

# Proyecto de Supabase. La URL y la clave anónima llegan al navegador: son
# públicas por diseño y la seguridad real vive en RLS.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Uso exclusivo de scripts de administración y de la Edge Function.
# NUNCA debe llevar el prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_DB_PASSWORD="your-db-password"

# GitHub Pages como sitio de proyecto: /<nombre-del-repositorio>.
# Dejar vacío para desarrollo local.
NEXT_PUBLIC_BASE_PATH=""

# Valores de respaldo mientras cargan los ajustes de la barbería.
# Se pueden cambiar desde Panel > Ajustes sin recompilar.
NEXT_PUBLIC_DEFAULT_TIMEZONE="America/Bogota"
NEXT_PUBLIC_DEFAULT_CURRENCY="COP"
NEXT_PUBLIC_DEFAULT_LOCALE="es-CO"
NEXT_PUBLIC_DEFAULT_WHATSAPP_COUNTRY_CODE="57"

# Muestra las cuentas de demostración en la pantalla de login.
# En producción debe quedar en "false" (o sin definir).
NEXT_PUBLIC_DEMO_MODE="false"

# Solo para `npm run db:seed:supabase`: barbería demo inicial.
SHOP_SLUG="en-silla"
SHOP_NAME="En-silla Barbershop"
SHOP_TIMEZONE="America/Bogota"
SHOP_CURRENCY="COP"
SHOP_LOCALE="es-CO"
SHOP_WHATSAPP_COUNTRY_CODE="57"

# --- Correo transaccional (Edge Functions `send-reminder` y `shop-signup`) ----
# Estas variables NO se usan en el build: se configuran en Supabase con
# `npx supabase secrets set ...`. Se listan acá como referencia.
# Con `BREVO_API_KEY` el envío sale por Brevo, que no exige dominio propio y
# reescribe el remitente por uno suyo. Con `RESEND_API_KEY` sale por Resend,
# que solo entrega a cualquier destinatario si el dominio está verificado.
BREVO_API_KEY="xkeysib-..."
RESEND_API_KEY=""
REMINDER_FROM_EMAIL="turnos@tu-dominio.com"
REMINDER_FROM_NAME="En-silla"
# URL pública del sitio (con el basePath si corresponde). Se usa para armar el
# retorno del enlace de confirmación del alta.
APP_BASE_URL="https://usuario.github.io/repositorio"

# Barbería que usa `npm run smoke:supabase` para las pruebas.
SMOKE_SHOP_SLUG="en-silla"
# Poner en "true" solo si la Edge Function está configurada y se acepta enviar
# un correo real de prueba.
SMOKE_SEND_REMINDER="false"
